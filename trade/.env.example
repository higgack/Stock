# Trade-bot credentials (NOT shared with the stock-bot; separate BotFather token).
TRADE_BOT_TOKEN=

# Comma-separated numeric chat IDs of the destination private channel(s).
# Leave empty on first boot — the bot logs the chat ID of every post it sees
# so you can grab it from `journalctl -u trade-bot`.
TRADE_CHANNEL_CHAT_IDS=

# Source channel filter. Set to "BeOn_BeClear" (username, no @) or the numeric
# -100... ID to drop any forwards that didn't originate there. Empty = accept all.
TRADE_SOURCE_ORIGIN=BeOn_BeClear

# Where the JSONL inbox and downstream artifacts live. Defaults to ~/.trade.
TRADE_DATA_DIR=

# Concurrent Telegram photo downloads. Default 8. Telegram's bot API tolerates
# ~30 req/sec; 8 leaves headroom for getUpdates traffic during BeOn bursts.
# Lower this if you start seeing RetryAfter errors in the journal.
TRADE_DOWNLOAD_CONCURRENCY=

# --- Backfill only (trade/scripts/backfill_beon.py) ---
# Personal-account Telegram API credentials for the one-time historical
# backfill of BeOn_BeClear → private trade channel. Get them at
# https://my.telegram.org/apps . Stored ONLY in .env (chmod 600), never
# committed. The backfill runs in its own .backfill-venv and is unused
# by the live trade-bot.
TRADE_TELETHON_API_ID=
TRADE_TELETHON_API_HASH=

# Adaptive pacing tunables (defaults: 1.5s → +0.1s every 500 msgs, cap 3.0s).
# Lower these to go faster (risk: bigger FloodWait near the end of a run).
# Raise them if even the defaults trigger FloodWait.
TRADE_PAUSE_BASE_S=
TRADE_PAUSE_INCREMENT_S=
TRADE_PAUSE_INCREMENT_EVERY=
TRADE_PAUSE_MAX_S=

# Past this wait the script exits gracefully (rerun next day to resume).
# Default 600 (= 10 min). Telegram occasionally hands back multi-hour
# waits — sleeping in-process for those wastes the operator's session.
TRADE_MAX_FLOOD_WAIT_S=

# Disk guard. Backfill pauses with a Telegram ⏸ alert when free space
# on / drops below TRADE_MIN_FREE_GB, then auto-resumes once it's back
# above TRADE_MIN_FREE_GB + TRADE_DISK_RESUME_BUFFER_GB (hysteresis).
# Defaults: 2.0 GB threshold, 0.5 GB hysteresis, check every 20 send units.
TRADE_MIN_FREE_GB=
TRADE_DISK_RESUME_BUFFER_GB=
TRADE_DISK_CHECK_EVERY=

# --- Dashboard server (trade.dashboard_server) ---
# All optional. With every value empty the server runs unauthenticated;
# fine behind a private network or SSH tunnel, but set USER + PASSWORD
# (and a TOKEN for extra obscurity) if exposing the port on the public
# internet. Trade-bot-dashboard.service reads these from this same file.
TRADE_DASHBOARD_TOKEN=
TRADE_DASHBOARD_USER=
TRADE_DASHBOARD_PASSWORD=

# --- Health check (trade.scripts.health_check) ---
# Dormancy threshold: alert when no new BeOn forward in last N hours.
# Default 72 (3 days). Lower for tighter monitoring, higher to tolerate
# longer BeOn lulls without false alarms.
TRADE_DORMANCY_HOURS=
# Cycle-gap grace: how many days past an expected BeOn publication
# (11/21/익월1/익월15) before alerting that the cycle is missing.
# Default 2.
TRADE_CYCLE_GAP_DAYS=
