# Copy this file to .env and fill in your keys
# .env is gitignored — never commit real keys

# Required: Google Gemini API key
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required for the Telegram bot — token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: comma-separated Telegram user IDs allowed to use the bot
# Find yours by messaging @userinfobot
# Comma-separated Telegram channel IDs the bot should respond to.
# If you don't know the ID yet, leave this empty and run the bot once —
# it will print the channel's chat ID when you post a ticker there.
# Example: CHANNEL_CHAT_IDS=-1001234567890
CHANNEL_CHAT_IDS=

# Optional: only needed if you switch data_vendors to alpha_vantage
# ALPHA_VANTAGE_API_KEY=

# Optional: where TradingAgents writes logs/cache/memory
# Defaults to ~/.tradingagents/
# TRADINGAGENTS_RESULTS_DIR=
# TRADINGAGENTS_CACHE_DIR=
# TRADINGAGENTS_MEMORY_LOG_PATH=
