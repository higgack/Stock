# Copy this file to .env and fill in your keys
# .env is gitignored — never commit real keys

# Required: Google Gemini API key
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required for the Telegram bot — token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: comma-separated Telegram user IDs allowed to use the bot
# Find yours by messaging @userinfobot
# Comma-separated Telegram channel IDs the bot should respond to.
# If you don't know the ID yet, leave this empty and run the bot once —
# it will print the channel's chat ID when you post a ticker there.
# Example: CHANNEL_CHAT_IDS=-1001234567890
CHANNEL_CHAT_IDS=

# Optional: only needed if you switch data_vendors to alpha_vantage
# ALPHA_VANTAGE_API_KEY=

# Optional: 자산 대시보드 'CSV 보내기' 버튼 (포트폴리오 스냅샷 전송).
# 텔레그램(즉시): 기본은 CHANNEL_CHAT_IDS 첫 채널로 전송.
#   PORTFOLIO_TG_CHAT_ID 를 설정하면 해당 DM 으로 우선 전송.
# PORTFOLIO_TG_CHAT_ID=
# 이메일: Gmail SMTP. SMTP_PASS 는 일반 비번이 아니라 '앱 비밀번호'
#   (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호). 노출 시 회전.
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# PORTFOLIO_EMAIL_TO=          # 비우면 SMTP_USER 로 (본인에게)

# Optional: where TradingAgents writes logs/cache/memory
# Defaults to ~/.tradingagents/
# TRADINGAGENTS_RESULTS_DIR=
# TRADINGAGENTS_CACHE_DIR=
# TRADINGAGENTS_MEMORY_LOG_PATH=

# Optional: LangSmith tracing for the analyst graph.
# Sign up at https://smith.langchain.com/ (free tier: 5K traces/month).
# When set, every Gemini call, tool call, and graph node automatically
# streams to your LangSmith dashboard — no code changes needed.
# Useful for debugging analyst retries, Pro thinking-token spend, and
# which step is the bottleneck of a slow run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=noah-stock
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
