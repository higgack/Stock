# Copy this file to .env and fill in your keys
# .env is gitignored — never commit real keys

# Required: Google Gemini API key (AI Studio / Gemini Developer API)
# Get one at: https://aistudio.google.com/apikey
# Leave blank if using Vertex AI (GOOGLE_GENAI_USE_VERTEXAI=true) below.
GOOGLE_API_KEY=

# Optional: route ALL Gemini calls through Vertex AI instead of the
# AI Studio key above. One switch moves the whole bot (analysts +
# decision tier, screener, daily/realestate/cheongyak briefs, chart
# translation, trade bot). Auth is Application Default Credentials (ADC)
# — no API key. Requires the host/VM service account to have
# roles/aiplatform.user and aiplatform.googleapis.com enabled.
# (Vertex explicit context caching is deferred — ~5% higher input cost.)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Required for the Telegram bot — token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: comma-separated Telegram user IDs allowed to use the bot
# Find yours by messaging @userinfobot
# Comma-separated Telegram channel IDs the bot should respond to.
# If you don't know the ID yet, leave this empty and run the bot once —
# it will print the channel's chat ID when you post a ticker there.
# Example: CHANNEL_CHAT_IDS=-1001234567890
CHANNEL_CHAT_IDS=

# Optional: only needed if you switch data_vendors to alpha_vantage
# ALPHA_VANTAGE_API_KEY=

# Optional: 자산 대시보드 'CSV 보내기' 버튼 (포트폴리오 스냅샷 전송).
# 텔레그램(즉시): 기본은 CHANNEL_CHAT_IDS 첫 채널로 전송.
#   PORTFOLIO_TG_CHAT_ID 를 설정하면 해당 DM 으로 우선 전송.
# PORTFOLIO_TG_CHAT_ID=
# 이메일: Gmail SMTP. SMTP_PASS 는 일반 비번이 아니라 '앱 비밀번호'
#   (Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호). 노출 시 회전.
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# PORTFOLIO_EMAIL_TO=          # 비우면 SMTP_USER 로 (본인에게)

# Optional: where TradingAgents writes logs/cache/memory
# Defaults to ~/.tradingagents/
# TRADINGAGENTS_RESULTS_DIR=
# TRADINGAGENTS_CACHE_DIR=
# TRADINGAGENTS_MEMORY_LOG_PATH=

# Optional: LangSmith tracing for the analyst graph.
# Sign up at https://smith.langchain.com/ (free tier: 5K traces/month).
# When set, every Gemini call, tool call, and graph node automatically
# streams to your LangSmith dashboard — no code changes needed.
# Useful for debugging analyst retries, Pro thinking-token spend, and
# which step is the bottleneck of a slow run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=noah-stock
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional: 52주 신고가·신저가 스캔 유니버스 상한 (시장별).
# 스캐너는 시총 상위 N 종목만 1년 일봉을 받는다(yfinance 호출 ≈ N 건).
# 시장별 키가 공용 키보다 우선 — CN 만 넓히고 JP/HK 는 그대로 둘 수 있다.
# 기본값: CN_A=500, JP/HK=5000 (US 는 전량 상장목록이라 이 값과 무관).
# ⚠️ 부하: 종목당 야후 요청 1건. :30 슬롯은 CN_A 와 US(5,625)를 함께 돌리고
#    스캔 예산은 25분(systemd 28분)이다. :00 슬롯이 US+JP=9,358 을 이미
#    소화하므로 CN_A 를 2000~3500 으로 올려도 그 검증된 부하 이하에 머문다.
#    전 A주(~5,400)로 올리려면 CN 을 별도 슬롯으로 분리하는 게 안전하다.
# HIGHLOW_UNIVERSE_CAP_CN_A=2000
# HIGHLOW_UNIVERSE_CAP_JP=5000
# HIGHLOW_UNIVERSE_CAP_HK=5000
# HIGHLOW_UNIVERSE_CAP=5000      # 시장별 키가 없을 때의 공용 폴백
