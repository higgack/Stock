[Unit]
Description=Standard View Telegram push (text-only, no HTML attachment)
After=standardview-backend.service network.target
Requires=standardview-backend.service

[Service]
Type=oneshot
User=higgack
WorkingDirectory=/home/higgack/standardview
Environment="PYTHONUNBUFFERED=1"
TimeoutStartSec=300
ExecStart=/home/higgack/standardview/.venv/bin/python /home/higgack/standardview/scripts/telegram_pusher.py --text-only
StandardOutput=journal
StandardError=journal
