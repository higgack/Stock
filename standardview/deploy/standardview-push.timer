[Unit]
Description=Trigger Standard View Telegram push at 08:00 + 21:00 Asia/Seoul (weekdays only)

[Timer]
# 평일(Mon-Fri) 만 push — 사용자 정책 2026-06-01 "주말에는 빼줘 받는
# 내용이 너무 많네". 주말 무음, weekly 종합(일 22:00) 은 별도 timer 유지.
# daily_generator (07:30/20:30) 는 매일 유지 — HTML 대시보드는 주말에도
# 신선하게.
OnCalendar=Mon..Fri *-*-* 08:00:00 Asia/Seoul
OnCalendar=Mon..Fri *-*-* 21:00:00 Asia/Seoul
Unit=standardview-push.service
Persistent=true

[Install]
WantedBy=timers.target
