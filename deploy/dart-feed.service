[Unit]
Description=DART Disclosure Feed — 전체 시장 공시 수집 + 대시보드 갱신 (30분 간격)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=higgack
WorkingDirectory=/home/higgack/stock
EnvironmentFile=/home/higgack/stock/.env
ExecStart=/home/higgack/stock/.venv/bin/python -m bot.dart_feed
StandardOutput=journal
StandardError=journal
# 300→600 (2026-07-24): 백로그 전용 쿼터 분리로 사이클당 attempt 총량이
# 늘어(오늘치 최대 60 + 백로그 최대 20) VM 실측상 300s 를 자주 넘겨
# SIGTERM 으로 죽는 사이클이 급증 — 단계별 즉시저장(run_once 참조)으로
# 유실 자체는 막았지만, 그래도 자주 죽으면 그 사이클의 남은 단계(특히
# 백로그) 진행이 못 끝나 매번 처음부터 재시도. 여유를 둬 정상 완주 빈도 ↑.
TimeoutStartSec=600
