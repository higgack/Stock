[Unit]
Description=US Market Daily trigger — 평일 07:30 KST (미국 장 마감 후)

[Timer]
# 평일(월-금) 07:30 KST. US 장 마감 16:00 ET = 06:00 KST (서머타임),
# 07:00 KST (윈터타임). 07:30 이면 양쪽 안정적 + 데이터 확정.
OnCalendar=Mon..Fri *-*-* 07:30:00 Asia/Seoul
Persistent=true
Unit=us-market-daily.service

[Install]
WantedBy=timers.target
