[Unit]
Description=Daily Byte Weekly trigger — 일요일 22:00 KST (SV standardview-weekly 와 동일 시각)

[Timer]
# 일요일 22:00 KST — SV weekly (standardview-weekly.timer) 와 같은 시각에
# 한 주 Daily Byte 아카이브를 종합. Persistent=true 로 서버 다운 시 부팅
# 후 1회 fire.
OnCalendar=Sun *-*-* 22:00:00 Asia/Seoul
Persistent=true
Unit=daily-byte-weekly.service

[Install]
WantedBy=timers.target
