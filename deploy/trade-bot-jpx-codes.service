[Unit]
Description=JPX listed-company code→English-name master (~/.trade/jpx_codes.json)
After=network-online.target

[Service]
# 혼합시장 보드(중국·말레이시아 등)의 도쿄 상장사 딥링크가 **신원 확인**에 쓰는
# 로컬 마스터를 만든다(trade.stock_link.jp_confirms). 원천 = JPX 영문
# 「その他統計資料」 data_e.xlsx — jp_master_probe VM 실측(2026-09-23)으로 골랐다.
#
# ⚠️ **별도 유닛인 이유**(독립 리뷰 2026-09-23): dashboard-refresh 안에 두면 한
# TimeoutStartSec 를 적재·렌더와 나눠 쓰는데, 느린 원천 하나가 그 예산을 먹거나
# 유닛째 강제 종료돼 inbox→DB→화면(유일한 경로)을 한 틱 막을 수 있다(#116).
# 여기선 이 장식용 단계가 제 예산 안에서만 실패한다.
# 빌더 규약: --if-stale = 없거나·7일 넘었거나·로더가 못 쓰는 파일일 때만 받는다.
# 실패(또는 끝나지 못한 시도) 뒤 6시간은 쉰다. 요청마다 총 30초 상한.
Type=oneshot
User=higgack
Group=higgack
WorkingDirectory=/home/higgack/stock-trade
EnvironmentFile=-/home/higgack/stock-trade/.env
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.scripts.build_jpx_codes --if-stale
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
