[Unit]
Description=Trade-bot health check (dormancy + cycle-gap → Telegram alert)
After=network-online.target

[Service]
Type=oneshot
User=higgack
Group=higgack
WorkingDirectory=/home/higgack/stock-trade
EnvironmentFile=-/home/higgack/stock-trade/.env
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.scripts.health_check
StandardOutput=journal
StandardError=journal
