[Unit]
Description=Daily Byte trigger — 평일 18:00 KST (사용자 2026-06-13 19→18)

[Timer]
# 평일(월-금) 18:00 KST (사용자 2026-06-13 19→18). pykrx 투자주체별
# EOD 는 통상 ~17-18시 갱신 — 18:00 정각엔 드물게 지연 가능, 그 경우
# daily_kr_flow 의 기존 walk-back 이 직전 거래일 데이터로 graceful.
# OnCalendar 의 요일은 Mon..Fri (day-of-
# week 자리), 월 숫자 자리와 구분. Asia/Seoul TZ 는 systemd 226+ 지원.
# Persistent=true 로 서버 다운 후 미실행 trigger 부팅 시 1회 fire.
OnCalendar=Mon..Fri *-*-* 18:00:00 Asia/Seoul
Persistent=true
Unit=daily-byte.service

[Install]
WantedBy=timers.target
