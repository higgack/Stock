[Unit]
Description=Korea Trade Dashboard HTTP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=higgack
Group=higgack
WorkingDirectory=/home/higgack/stock-trade
EnvironmentFile=-/home/higgack/stock-trade/.env
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.dashboard_server --port 8082 --bind 0.0.0.0
Restart=always
RestartSec=5
# Cycle the process daily so stdlib http.server's slow growth (if any)
# never accumulates indefinitely.
RuntimeMaxSec=86400
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
