[Unit]
Description=큐레이션 후보 알림 — 관세청 갱신일(1·11·15·21) 18:00 KST

[Timer]
# 관세청 10일 단위 잠정(11·21일)·월초(전월 풀월)·확정(~15일) 발표 직후. 18:00 =
# 그날 customs fetch 가 끝난 뒤라 by_mti 가 최신. 미매핑 고수출 품목을 DM
# (사용자 2026-06-15 '관세청 업데이트 때만 18:00'). Persistent=true 로 다운 시 보정.
OnCalendar=*-*-01,11,15,21 18:00:00 Asia/Seoul
Persistent=true
Unit=trade-bot-curation.service

[Install]
WantedBy=timers.target
