[Unit]
Description=관세청 customs fetch (pins) + 전 chapter 급변 스캔 + ±30%% DM (gated)
After=network-online.target

[Service]
Type=oneshot
User=higgack
Group=higgack
WorkingDirectory=/home/higgack/stock-trade
EnvironmentFile=-/home/higgack/stock-trade/.env
# Three passes per tick (ordering matters — each reads what the prior wrote):
#   1. fetch_customs — pull official monthly figures for operator-PINNED
#      items into customs.db. SILENT (journal only).
#   2. customs_alert — evaluate the pinned months just cached; DM the
#      operator only when a NEW month's export 전월비 exceeds
#      ±TRADE_CUSTOMS_ALERT_PCT (default 30). Baseline-silent on first run /
#      new pins, hard-capped, operator DM only — never the channel.
#   3. scan_customs — sweep ALL HS chapters 01~97, rank 📈급등률 / 💵급증액
#      TOP30, refresh the live snapshot + append to the permanent archive,
#      DM only NEW entrants (baseline-silent first run). This is the
#      auto-discovery layer; the pins above are the manual layer.
#   4. trade.dashboard — re-render index.html immediately so the new
#      surge snapshot shows without waiting for the next 5-min
#      dashboard-refresh tick (otherwise the panel can lag a scan by up
#      to 5 min — visible after a manual scan). Reads store.db only;
#      cheap (~1 s). The 5-min refresh still runs independently.
# All idempotent; runs 4×/day (see .timer) so a publication is caught
# within ~6h. Quiet ticks send nothing.
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.scripts.fetch_customs
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.scripts.customs_alert
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.scripts.scan_customs
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.dashboard
StandardOutput=journal
StandardError=journal
