[Unit]
Description=Fetch 관세청 monthly figures for pinned items into customs.db (silent)
After=network-online.target

[Service]
Type=oneshot
User=higgack
Group=higgack
WorkingDirectory=/home/higgack/stock-trade
EnvironmentFile=-/home/higgack/stock-trade/.env
# Pulls official monthly export/import figures for the items pinned via
# hs_map and caches them. Sends NO Telegram messages — journal only. The
# ±30% change alert is a separate (later) script, so this daily poll is
# silent on quiet days.
ExecStart=/home/higgack/stock-trade/.venv/bin/python -m trade.scripts.fetch_customs
StandardOutput=journal
StandardError=journal
