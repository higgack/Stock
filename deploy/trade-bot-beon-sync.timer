[Unit]
Description=BeOn 수출입 데이터 정기 동기화 타이머
After=network-online.target

[Timer]
# Run every 2 hours (00/02/04/.../22:00 UTC) so new BeOn posts are
# forwarded within ≤2 h of publication regardless of when they arrive.
# Cost: negligible — runs with no new messages only do a read-only
# iter_messages scan and exit silently (idempotent, no forward calls).
OnCalendar=*-*-* 00/2:00:00 UTC
# If the server was down during a scheduled run, catch up once on next boot.
Persistent=true
Unit=trade-bot-beon-sync.service

[Install]
WantedBy=timers.target
