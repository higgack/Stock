[Unit]
Description=US Market Daily — 미국 장 마감 후 시장 브리프 텔레그램 푸시 (07:00 KST)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=higgack
WorkingDirectory=/home/higgack/stock
EnvironmentFile=/home/higgack/stock/.env
ExecStart=/home/higgack/stock/.venv/bin/python -m bot.us_market_daily
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
