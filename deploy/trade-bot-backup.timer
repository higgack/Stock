[Unit]
Description=Daily snapshot of trade-bot store.db (~03:00 KST)

[Timer]
# 03:00 KST = 18:00 UTC the previous day. systemd OnCalendar uses
# the host's local timezone — set it via the unit override or rely
# on UTC if you prefer. Here we use 18:00 UTC for predictability.
OnCalendar=*-*-* 18:00:00 UTC
Unit=trade-bot-backup.service
Persistent=true

[Install]
WantedBy=timers.target
