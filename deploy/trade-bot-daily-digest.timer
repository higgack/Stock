[Unit]
Description=자정 결산 트리거 — 00:03 KST (unstored_check 00:00 직후)

[Timer]
# 어제(KST) 하루 결산 — BeOn 포워드 건수 + 관세청 스윕/갱신/오류.
# 활동·이상이 전혀 없는 날은 무음 (사용자 2026-06-13 '실제 작동하는
# 날에만'). Persistent=true 로 서버 다운 시 부팅 후 1회 보정.
OnCalendar=*-*-* 00:03:00 Asia/Seoul
Persistent=true
Unit=trade-bot-daily-digest.service

[Install]
WantedBy=timers.target
